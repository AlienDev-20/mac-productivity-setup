# ════════════════════════════════════════════════════════════
# Brewfile — base productiva para macOS
# ════════════════════════════════════════════════════════════
# Solo herramientas universales. Agregá lo que necesites según
# tu workflow (lenguajes, frameworks, apps específicas).
#
# Después de instalar algo nuevo:
#   brewdump   # alias en .zshrc → brew bundle dump --force

# ─── Modern Unix replacements ──────────────────────────────
brew "bat"                # cat con syntax highlighting
brew "duf"                # df mejorado
brew "dust"               # du visual
brew "eza"                # ls moderno con icons + git
brew "fd"                 # find moderno
brew "fzf"                # fuzzy finder
brew "ripgrep"            # rg — grep moderno (mucho más rápido)
brew "sd"                 # sed moderno (sintaxis intuitiva)

# ─── Shell tooling ─────────────────────────────────────────
brew "starship"           # prompt
brew "zoxide"             # smart cd (z command)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ─── Git / GitHub ──────────────────────────────────────────
brew "git"                # versión moderna (no Apple git)
brew "gh"                 # GitHub CLI

# ─── Editor ────────────────────────────────────────────────
brew "neovim"

# ─── Terminal multiplexer ──────────────────────────────────
brew "zellij"             # alternativa moderna a tmux

# ─── Modern bash (para scripts) ────────────────────────────
brew "bash"               # macOS trae bash 3.2 ancestral; esta es 5.x

# ─── Celular en OBS ────────────────────────────────────────
brew "scrcpy"             # espeja Android en una ventana capturable por OBS

# ─── Apps GUI ──────────────────────────────────────────────
cask "ghostty"                              # terminal GPU-accelerated
cask "raycast"                              # launcher + productividad
cask "font-jetbrains-mono-nerd-font"        # fuente con icons
cask "cold-turkey-blocker"                  # bloqueo de apps/sitios (Pro, licencia por equipo)
