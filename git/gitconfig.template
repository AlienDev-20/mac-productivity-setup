[user]
	name = {{NAME}}
	email = {{EMAIL}}
	signingkey = {{HOME}}/.ssh/id_ed25519.pub
[core]
	editor = nvim
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
	default = simple
[column]
	ui = auto
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[color]
	ui = auto
[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	amend = commit --amend --no-edit
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = {{HOME}}/.ssh/allowed_signers
[url "git@github.com:"]
	insteadOf = https://github.com/
