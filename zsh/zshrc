# ════════════════════════════════════════════════════════════
# ~/.zshrc — Mac productivity base
# ════════════════════════════════════════════════════════════

# ─── Homebrew ──────────────────────────────────────────────
eval "$(/opt/homebrew/bin/brew shellenv)"

# Comportamiento de Homebrew
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_BUNDLE_FILE="$HOME/dotfiles/Brewfile"

# ─── PATH ──────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ─── Editor ────────────────────────────────────────────────
export EDITOR="nvim"
export VISUAL="nvim"

# ─── History ───────────────────────────────────────────────
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=100000
setopt APPEND_HISTORY           # append instead of overwrite
setopt EXTENDED_HISTORY         # save timestamps
setopt HIST_EXPIRE_DUPS_FIRST   # expire duplicates first
setopt HIST_IGNORE_DUPS         # ignore consecutive duplicates
setopt HIST_IGNORE_ALL_DUPS     # remove older duplicates
setopt HIST_IGNORE_SPACE        # ignore commands starting with space
setopt HIST_FIND_NO_DUPS        # no duplicates in search
setopt HIST_REDUCE_BLANKS       # strip extra whitespace
setopt INC_APPEND_HISTORY       # write immediately
setopt SHARE_HISTORY            # share across sessions

# ─── Shell options ─────────────────────────────────────────
setopt AUTO_CD                  # type dir name to cd
setopt AUTO_PUSHD               # cd pushes to dirstack
setopt PUSHD_IGNORE_DUPS        # no duplicates in dirstack
setopt INTERACTIVE_COMMENTS     # allow # comments interactively
setopt GLOB_DOTS                # include dotfiles in globs
setopt NO_BEEP                  # shhh

# ─── Completion ────────────────────────────────────────────
autoload -Uz compinit
compinit -u
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ─── Zoxide (smart cd) ─────────────────────────────────────
eval "$(zoxide init zsh)"

# ─── fzf (fuzzy finder) ────────────────────────────────────
source <(fzf --zsh)
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"

# ─── Starship (prompt) ─────────────────────────────────────
eval "$(starship init zsh)"

# ─── zsh plugins ───────────────────────────────────────────
# IMPORTANT: syntax-highlighting MUST be sourced LAST
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ─── Aliases ───────────────────────────────────────────────
# Modern CLI replacements (eza for ls)
alias ls="eza --icons --group-directories-first"
alias ll="eza -lah --icons --group-directories-first --git"
alias la="eza -a --icons --group-directories-first"
alias tree="eza --tree --icons --level=2"

# Shortcuts
alias g="git"
alias v="nvim"
alias c="clear"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Brew
alias brewup="brew update && brew upgrade && brew cleanup"
# brewdump vuelca TU inventario completo a Brewfile.local (ignorado por git).
# Los Brewfile del equipo (Brewfile, Brewfile.claude, Brewfile.extras) se editan a mano.
alias brewdump="brew bundle dump --file=$HOME/dotfiles/Brewfile.local --force"

# Claude Code (Fase 2 — ./setup-claude.sh)
# `cc` → retoma la última conversación en el directorio actual.
alias cc="claude -c"

# Zellij layouts — multi-agent workflows
# `agents` → 4 panes en columnas para correr Claude Code agents en paralelo.
# Si la sesión ya existe, hace attach; si no, la crea con el layout.
unalias agents 2>/dev/null  # evita conflicto si el .zshrc se re-sourcea
agents() {
  if zellij list-sessions 2>/dev/null | grep -q "agents"; then
    zellij attach agents
  else
    zellij --layout ~/dotfiles/zellij/layouts/agents.kdl --session agents
  fi
}
